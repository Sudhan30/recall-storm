+def _is_ambiguous_additive_match(
+    text: str, match: re.Match[str], rules: list[Rule]
+) -> tuple[bool, str]:
+    """Check if a matched additive is immediately qualified by a conflicting/regional parenthetical."""
+    after = text[match.end() :]
+    pm = _FOLLOWING_PAREN_PATTERN.match(after)
+    if not pm:
+        return False, ""
+    paren_body = pm.group(1) if pm.group(1) is not None else (pm.group(2) or "")
+    if _find_additive_match(paren_body, rules) is not None:
+        return False, ""
+    if _CONFLICTING_PAREN_CONTENT.search(paren_body):
+        return (
+            True,
+            f"Matched additive '{match.group(0)}' has conflicting/regional qualification '({paren_body})' requiring verification.",
+        )
+    return False, ""
+
