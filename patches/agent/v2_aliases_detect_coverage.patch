+def _ocr_clean_word_digits(text: str) -> str:
+    """Normalize OCR digit-for-letter substitutions inside alphabetic tokens without changing length."""
+    chars = list(text)
+    n = len(chars)
+    repl = {"0": "O", "1": "I", "3": "E", "5": "S", "8": "B"}
+    for i, ch in enumerate(chars):
+        if ch in repl:
+            prev_alpha = i > 0 and chars[i - 1].isalpha()
+            next_alpha = i + 1 < n and chars[i + 1].isalpha()
+            if (prev_alpha and next_alpha) or (
+                ch == "0" and prev_alpha and i + 1 < n and chars[i + 1] == "."
+            ) or (
+                ch == "3" and not prev_alpha and i + 2 < n and chars[i + 1].isalpha() and chars[i + 2].isalpha()
+            ):
+                target = repl[ch]
+                ref = chars[i - 1] if prev_alpha else chars[i + 1]
+                chars[i] = target.lower() if ref.islower() else target
+    return "".join(chars)
+
