+def _fuzzy_alias_pattern(clean: str) -> str:
+    """Build an OCR- and spacing-tolerant regex pattern for a general alias."""
+    folded = fold_unicode(clean)
+    parts: list[str] = []
+    i = 0
+    n = len(folded)
+    while i < n:
+        ch = folded[i]
+        if ch.isspace():
+            while i < n and folded[i].isspace():
+                i += 1
+            parts.append(r"[\s.\-]*")
+            continue
+        if ch in ".-":
+            while i < n and (folded[i].isspace() or folded[i] in ".-"):
+                i += 1
+            parts.append(r"[\s.\-]*")
+            continue
+        if ch == "&":
+            i += 1
+            while i < n and folded[i].isspace():
+                i += 1
+            parts.append(r"\s*(?:&\s*|\s+AND\s+)\s*")
+            continue
+        upper_ch = ch.upper()
+        if upper_ch in _OCR_CHAR_MAP:
+            parts.append(_OCR_CHAR_MAP[upper_ch])
+        else:
+            parts.append(re.escape(ch))
+        i += 1
+    return "".join(parts)
