+def _assoc_task_window(
+    assoc: Associate | None,
+    base_start: datetime,
+    deadline: datetime,
+    tz_name: str,
+    task_idx: int,
+    total_tasks: int,
+) -> list[str]:
+    """Compute a non-overlapping window inside the associate's shift and before deadline."""
+    avail_start = assoc.shift_start if assoc is not None else base_start
+    shift_end = assoc.shift_end if assoc is not None else deadline
+    safe_deadline = deadline - timedelta(minutes=5)
+    if safe_deadline <= avail_start:
+        safe_deadline = deadline - timedelta(minutes=1)
+    avail_end = min(shift_end, safe_deadline)
+    if avail_end <= avail_start:
+        avail_end = min(shift_end, deadline)
+
+    count = max(1, total_tasks)
+    total_mins = int((avail_end - avail_start).total_seconds() // 60)
+
+    if total_mins >= 6 * count:
+        t_start = avail_start + timedelta(minutes=6 * task_idx)
+        return task_window(t_start, 5, avail_end + timedelta(minutes=5), tz_name)
+
+    if total_mins >= 2 * count:
+        step_mins = total_mins // count
+        dur_mins = max(1, step_mins - 1)
+        t_start = avail_start + timedelta(minutes=step_mins * task_idx)
+        w_end = t_start + timedelta(minutes=dur_mins)
+        return [iso_with_offset(t_start, tz_name), iso_with_offset(w_end, tz_name)]
+
+    total_secs = max(2 * count, int((avail_end - avail_start).total_seconds()))
+    step_secs = max(2, total_secs // count)
+    dur_secs = max(1, step_secs - max(1, step_secs // 5))
+    w_start = avail_start + timedelta(seconds=step_secs * task_idx)
+    w_end = min(avail_end, w_start + timedelta(seconds=dur_secs))
+    return [iso_with_offset(w_start, tz_name), iso_with_offset(w_end, tz_name)]
+
+
