+def _expand_lot_range(start_tok: str, end_tok: str) -> list[str]:
+    m1 = re.match(r"^([A-Z]*?)(\d+)([A-Z]*)$", start_tok.upper())
+    m2 = re.match(r"^([A-Z]*?)(\d+)([A-Z]*)$", end_tok.upper())
+    if not (m1 and m2):
+        return []
+    if m1.group(1) != m2.group(1) or m1.group(3) != m2.group(3) or len(m1.group(2)) != len(m2.group(2)):
+        return []
+    n1, n2 = int(m1.group(2)), int(m2.group(2))
+    if n2 < n1 or n2 - n1 > 1000:
+        return []
+    width = len(m1.group(2))
+    prefix, suffix = m1.group(1), m1.group(3)
+    return [f"{prefix}{str(i).zfill(width)}{suffix}" for i in range(n1, n2 + 1)]
+
+
+def _parse_lot_segment(seg: str) -> list[str]:
+    out: list[str] = []
+    cleaned = _DATE_TOKEN_RE.sub(" ", seg)
+    for clause in re.split(r"[,;]+", cleaned):
+        rem = clause
+        for m in _LOT_RANGE_RE.finditer(clause):
+            expanded = _expand_lot_range(m.group(1), m.group(2))
+            if expanded:
+                out.extend(expanded)
+                rem = rem.replace(m.group(0), " ", 1)
+        for m in _COMPACT_RANGE_RE.finditer(rem):
+            expanded = _expand_lot_range(m.group(1), m.group(2))
+            if expanded:
+                out.extend(expanded)
+                rem = rem.replace(m.group(0), " ", 1)
+        for tok in re.split(r"\s+", rem.strip()):
+            t = tok.strip(".,;:#()[]\"'").upper()
+            if not t or t in _STOPWORDS:
+                continue
+            if 3 <= len(t) <= 20 and re.match(r"^[A-Z0-9\-]+$", t) and any(c.isdigit() for c in t):
+                if t.isdigit() and len(t) >= 12:
+                    continue
+                out.append(t)
+    return out
+
